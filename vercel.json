{
  "rewrites": [
    { "source": "/", "destination": "/pages/home.html" },
    { "source": "/shows", "destination": "/pages/shows.html" },
    { "source": "/media", "destination": "/pages/media.html" },
    { "source": "/about", "destination": "/pages/about.html" },
    { "source": "/contact", "destination": "/pages/contact.html" }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "sync/**/*.json"
    }
  }
}